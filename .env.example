# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Edge Functions / Secret values (DO NOT expose these to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SERPAPI_KEY=your-serpapi-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
DEMO_PRICE_SIMULATION=true
DEMO_PRICE_UPDATE_MINUTES=5
DEMO_PRICE_UPDATE_MAX_MINUTES=10
CRON_SECRET=your-secure-random-cron-secret